<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ backup & device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude caches and temporary files -->
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="no_backup/"/>

        <!-- Exclude any SharedPreferences that may hold auth tokens or session data -->
        <exclude domain="sharedpref" path="com.phoenixcorp.founderfinder_preferences.xml"/>
        <exclude domain="sharedpref" path="firebase_auth_preferences.xml"/>
        <exclude domain="sharedpref" path="com.google.firebase.auth.preferences.xml"/>
    </cloud-backup>

    <device-transfer>
        <!-- Same exclusions for device-to-device transfer -->
        <exclude domain="file" path="cache/"/>
        <exclude domain="file" path="no_backup/"/>
        <exclude domain="sharedpref" path="com.phoenixcorp.founderfinder_preferences.xml"/>
        <exclude domain="sharedpref" path="firebase_auth_preferences.xml"/>
        <exclude domain="sharedpref" path="com.google.firebase.auth.preferences.xml"/>
    </device-transfer>
</data-extraction-rules>