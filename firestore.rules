rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow service account access for Cloud Functions
    function isServiceAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // Debug function to log organization membership checks
    function debugOrganizationMember(orgId, userId) {
      let isCreator = get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == userId;
      let isPartner = exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(userId));
      let isCollaborator = exists(/databases/$(database)/documents/organizations/$(orgId)/collaborators/$(userId));
      let isMember = isCreator || isPartner || isCollaborator;
      return isMember;
    }

    // Temporary permissive rule for debugging (REMOVE AFTER TESTING)
    match /group_conversations/{orgId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Original rule (uncomment after debugging)
    /*
    match /group_conversations/{orgId} {
      allow read, write: if request.auth != null && debugOrganizationMember(orgId, request.auth.uid) || isServiceAccount();
      match /messages/{messageId} {
        allow read: if request.auth != null && debugOrganizationMember(orgId, request.auth.uid) || isServiceAccount();
        allow write: if request.auth != null && debugOrganizationMember(orgId, request.auth.uid) && request.resource.data.senderId == request.auth.uid || isServiceAccount();
      }
    }
    */

    // Profiles: Read for all authenticated, write for owner
    match /profiles/{userId} {
      allow read: if request.auth != null || isServiceAccount();
      allow write: if request.auth != null && request.auth.uid == userId;

      match /advisor/{document=**} {
        allow read: if request.auth != null || isServiceAccount();
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /partner/{document=**} {
        allow read: if request.auth != null || isServiceAccount();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Users: Read/write for owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isServiceAccount();
    }

    // Conversations: Permissions for participants
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) || isServiceAccount();
      allow write: if request.auth != null && (
        (resource == null && request.resource.data.participantIds != null && request.auth.uid in request.resource.data.participantIds) ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds)
      ) || isServiceAccount();
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        ) || isServiceAccount();
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        ) || isServiceAccount();
      }
    }

    // Collection group for messages
    match /{path=**}/messages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      ) || isServiceAccount();
      allow write: if request.auth != null && resource.data.senderId == request.auth.uid || isServiceAccount();
    }

    // Collection group for forums
    match /{path=**}/forum/{forumId} {
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.creatorId == "system"
      ) || isServiceAccount();
    }

    // Collection group for threads
    match /{path=**}/threads/{threadId} {
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.institutionName in ['6614e8be-bc70-43dc-9306-2aeb654fa669']
      ) || isServiceAccount();
    }

    // Collection group for comments
    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.engagedUsers ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.parentId == 'none'
      ) || isServiceAccount();
      allow write: if request.auth != null && resource.data.creatorId == request.auth.uid || isServiceAccount();
    }

    // Forums: Read for authenticated, write with restrictions
    match /category/{categoryName}/forum/{forumId} {
      allow read: if request.auth != null || isServiceAccount();
      allow write: if request.auth != null && (
        request.resource.data.creatorId == request.auth.uid ||
        resource.data.creatorId == "system"
      );

      match /threads/{threadId} {
        allow read: if request.auth != null || isServiceAccount();
        allow write: if request.auth != null;

        match /comments/{commentId} {
          allow read: if request.auth != null || isServiceAccount();
          allow write: if request.auth != null;
        }
      }

      match /likes/{userId} {
        allow read: if request.auth != null || isServiceAccount();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Organizations: Read for authenticated, write for creator or partners
    match /organizations/{orgId} {
      allow read: if request.auth != null || isServiceAccount();
      allow write: if request.auth != null && (
        request.resource.data.creatorId == request.auth.uid ||
        exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(request.auth.uid))
      );

      match /activities/{activityId} {
        allow read: if request.auth != null && (
          exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/organizations/$(orgId)/collaborators/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          resource.data.creatorId == request.auth.uid
        ) || isServiceAccount();
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(request.auth.uid)) ||
          resource.data.creatorId == request.auth.uid
        ) || isServiceAccount();
      }

      match /files/{fileId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/organizations/$(orgId)/collaborators/$(request.auth.uid)) ||
          request.auth.uid in resource.data.sharedWith ||
          exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.auth.uid))
        ) || isServiceAccount();
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(request.auth.uid))
        );
      }

      match /invitations/{invitationId} {
        allow read: if request.auth != null && (
          request.auth.uid == resource.data.inviteeId ||
          request.auth.uid == resource.data.inviterId
        ) || isServiceAccount();
        allow write: if request.auth != null && (
          (resource == null &&
           request.resource.data.inviterId == request.auth.uid &&
           (get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
            exists(/databases/$(database)/documents/organizations/$(orgId)/partners/$(request.auth.uid)))) ||
          (request.auth.uid == resource.data.inviterId) ||
          (request.auth.uid == resource.data.inviteeId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
           request.resource.data.status in ["accepted", "denied"])
        ) || isServiceAccount();
      }

      match /collaborators/{userId} {
        allow read: if request.auth != null || isServiceAccount();
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          (request.auth.uid == userId &&
           exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(userId)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(userId)).data.status == "accepted")
        );
      }

      match /partners/{userId} {
        allow read: if request.auth != null || isServiceAccount();
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.creatorId == request.auth.uid ||
          (request.auth.uid == userId &&
           exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(userId)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(userId)).data.status == "accepted")
        );
      }
    }

    // Invitations: Top-level
    match /invitations/{invitationId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      ) || isServiceAccount();
      allow write: if request.auth != null && (
        (resource == null &&
         request.resource.data.inviterId == request.auth.uid &&
         exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)) &&
         get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.creatorId == request.auth.uid) ||
        (request.auth.uid == resource.data.inviterId) ||
        (request.auth.uid == resource.data.inviteeId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]) &&
         request.resource.data.status in ["accepted", "denied"])
      ) || isServiceAccount();
    }

    // Incubators: Read for authenticated, write for creator
    match /incubators/{incubatorId} {
      allow read: if request.auth != null || isServiceAccount();
      allow write: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
    }

    // Investors: Read for authenticated, write for owner
    match /investors/{investorId} {
      allow read: if request.auth != null || isServiceAccount();
      allow write: if request.auth != null && request.auth.uid == investorId;
    }

    // Collection group for activities
    match /{path=**}/activities/{activityId} {
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/partners/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/collaborators/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.creatorId == request.auth.uid
      ) || isServiceAccount();
      allow write: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/partners/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.creatorId == request.auth.uid
      ) || isServiceAccount();
    }

    // Notifications: Read/write for owner
    match /notifications/{userId}/userNotifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId || isServiceAccount();
      allow write: if request.auth != null && request.auth.uid == userId || isServiceAccount();
    }
  }
}